{
  "mcpServers": {
    "dataverse-ai-action-platform": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/dataverse-mcp.mjs"
      ],
      "env": {
        "DATAVERSE_URL": "${DATAVERSE_URL}",
        "AZURE_TENANT_ID": "${AZURE_TENANT_ID}",
        "AZURE_CLIENT_ID": "${AZURE_CLIENT_ID}",
        "AZURE_CLIENT_SECRET": "${AZURE_CLIENT_SECRET}",
        "AZURE_CLIENT_CERTIFICATE_PEM": "${AZURE_CLIENT_CERTIFICATE_PEM}",
        "AZURE_CLIENT_CERTIFICATE_PRIVATE_KEY_PEM": "${AZURE_CLIENT_CERTIFICATE_PRIVATE_KEY_PEM}",
        "AZURE_CLIENT_CERTIFICATE_THUMBPRINT": "${AZURE_CLIENT_CERTIFICATE_THUMBPRINT}",
        "AZURE_MANAGED_IDENTITY_CLIENT_ID": "${AZURE_MANAGED_IDENTITY_CLIENT_ID}",
        "DATAVERSE_ACCESS_TOKEN": "${DATAVERSE_ACCESS_TOKEN}",
        "DATAVERSE_OAUTH_SCOPE": "${DATAVERSE_OAUTH_SCOPE}",
        "DATAVERSE_AUTH_MODE": "${DATAVERSE_AUTH_MODE}",
        "DATAVERSE_ALLOW_WRITES": "${DATAVERSE_ALLOW_WRITES}",
        "DATAVERSE_MAX_TOP": "${DATAVERSE_MAX_TOP}",
        "DATAVERSE_RETRY_ATTEMPTS": "${DATAVERSE_RETRY_ATTEMPTS}",
        "DATAVERSE_RETRY_BASE_MS": "${DATAVERSE_RETRY_BASE_MS}",
        "DATAVERSE_REQUEST_TIMEOUT_MS": "${DATAVERSE_REQUEST_TIMEOUT_MS}",
        "DATAVERSE_AUDIT_LOG": "${DATAVERSE_AUDIT_LOG}",
        "DATAVERSE_ALLOWED_ENTITY_SETS": "${DATAVERSE_ALLOWED_ENTITY_SETS}",
        "DATAVERSE_BLOCKED_ENTITY_SETS": "${DATAVERSE_BLOCKED_ENTITY_SETS}",
        "DATAVERSE_BLOCKED_COLUMNS": "${DATAVERSE_BLOCKED_COLUMNS}"
      }
    }
  }
}
