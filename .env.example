# Dataverse organization URL.
DATAVERSE_URL=https://your-org.crm4.dynamics.com

# Microsoft Entra app registration for OAuth2 client credentials.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=

# Optional override. Defaults to DATAVERSE_URL + /.default.
DATAVERSE_OAUTH_SCOPE=https://your-org.crm4.dynamics.com/.default

# Auth modes: auto, device_code, client_credentials.
DATAVERSE_AUTH_MODE=auto

# Optional direct bearer token alternative for local troubleshooting.
DATAVERSE_ACCESS_TOKEN=

# Keep writes disabled by default. Set to true only after governance review.
DATAVERSE_ALLOW_WRITES=false

# Maximum OData $top value enforced by the MCP server.
DATAVERSE_MAX_TOP=500

# Runtime hardening.
DATAVERSE_RETRY_ATTEMPTS=3
DATAVERSE_RETRY_BASE_MS=500
DATAVERSE_REQUEST_TIMEOUT_MS=30000

# Optional local JSONL audit log path. Keep outside source control.
DATAVERSE_AUDIT_LOG=
